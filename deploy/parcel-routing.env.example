# Copy this file to /etc/parcel-routing/parcel-routing.env on EC2.
# Do not commit the copied file: it contains production secrets.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
PARCEL_DB_URL=jdbc:postgresql://127.0.0.1:5432/parcel_routing
PARCEL_DB_USERNAME=replace-with-database-user
PARCEL_DB_PASSWORD=replace-with-database-password
PARCEL_OPERATOR_PASSWORD=replace-with-strong-operator-password
PARCEL_APPROVER_PASSWORD=replace-with-strong-approver-password
PARCEL_ADMIN_PASSWORD=replace-with-strong-admin-password
